# ── Required ────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs and encrypt stored OAuth tokens.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Client branding
CLIENT_NAME="Acme Plumbing"
# Domain(s) of the client's public website, comma separated. Used to build the
# CORS allowlist for /api/leads/capture and /api/posts.
# Bare domains allow https:// and https://www.; full origins are used as-is.
CLIENT_DOMAIN=acmeplumbing.com

# Base URL of this portal (no trailing slash). Used for Google OAuth redirects.
APP_URL=https://portal.acmeplumbing.com

# ── Database ────────────────────────────────────────────────────────────────
# Path to the SQLite file. Defaults to ./data/portal.db
DATABASE_URL=./data/portal.db

# ── First-run portal user (single user per portal) ─────────────────────────
# Seeded on first boot if the users table is empty.
# Alternatively run: npm run create-user -- <email> <password>
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=

# ── Maintenance tickets → Discord ──────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Google Search Console (OAuth, read-only scope) ─────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret for the daily analytics sync endpoint (GET /api/cron/sync with
# "Authorization: Bearer {CRON_SECRET}").
CRON_SECRET=

# ── Reserved for magic-link auth (not used yet) ────────────────────────────
RESEND_API_KEY=
